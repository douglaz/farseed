# Dedicated table only. Destroy/recreate is an atomic transaction and never flushes
# other tables. Established inbound SSH survives. Substitute the numeric UID and
# configured DNS IPv4 at deployment; DNS is UDP only, to this endpoint and port.
define relay_uid = 999
define resolver = 192.0.2.53
destroy table inet tau_relay
table inet tau_relay {
    set forbidden4 {
        type ipv4_addr
        flags interval
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
            169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
            192.31.196.0/24, 192.52.193.0/24, 192.88.99.0/24, 192.168.0.0/16,
            192.175.48.0/24, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
            224.0.0.0/4, 240.0.0.0/4 }
    }
    set forbidden6 {
        type ipv6_addr
        flags interval
        elements = { 2001::/23, 2001:db8::/32, 2002::/16, 2620:4f:8000::/48, 3fff::/20 }
    }
    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state established,related accept
        tcp dport { 22, 80, 443 } accept
    }
    chain output {
        type filter hook output priority filter; policy accept;
        # Replies on accepted loopback connections to the front proxy are allowed;
        # a new relay TCP connection to loopback cannot match this exception.
        meta skuid $relay_uid oifname "lo" ct direction reply ct state established accept
        meta skuid $relay_uid ip daddr $resolver udp dport 53 accept
        meta skuid $relay_uid tcp dport != 22 reject
        meta skuid $relay_uid ip daddr @forbidden4 reject
        meta skuid $relay_uid ip6 daddr != 2000::/3 reject
        meta skuid $relay_uid ip6 daddr @forbidden6 reject
        meta skuid $relay_uid fib daddr type local reject
    }
}
